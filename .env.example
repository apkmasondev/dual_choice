# APK — DUAL / CHOICE
#
# The ONLY inputs the experience needs that cannot be derived from the assets.
# Copy this file to `.env` (local) or set the values as repository variables in
# the GitHub Pages workflow. Both are optional: when a value is missing the
# matching call-to-action is not rendered at all, rather than pointing nowhere.

# Where "START A PROJECT" sends the visitor (contact page, form or mailto:).
VITE_CONTACT_URL=

# Where "VIEW MORE WORK" sends the visitor (portfolio index).
VITE_PORTFOLIO_URL=

# Absolute origin of the deployed site. Used for <link rel="canonical">,
# og:image and sitemap.xml. Leave empty to emit relative URLs only.
VITE_SITE_ORIGIN=
